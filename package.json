{
	"name": "@jibb-open/jssdk",
	"version": "3.18.8",
	"description": "JavaScript SDK for JIBB APIs and Webex device integrations.",
	"main": "dist/index.js",
	"type": "module",
	"files": [
		"api/**/*.js",
		"config.js",
		"dist/**/*.js",
		"jibb_WebexXapi.js",
		"types/**/*.js",
		"utils/**/*.js",
		"ws/**/*.js",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "npm run build && node --test",
		"coverage": "npm run build && node --test --experimental-test-coverage",
		"build": "babel src --out-dir dist --no-copy-ignored --config-file ./.babelrc",
		"build-macro": "rollup -c rollup.config.mjs",
		"watch": "npm run build -- --watch",
		"docs": "jsdoc -c ./jsdoc-config.json -r ./src/ ./README.md --destination docs"
	},
	"repository": "https://github.com/Inkerz/jibb-jssdk",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Inkerz/jibb-jssdk/issues"
	},
	"homepage": "https://github.com/Inkerz/jibb-jssdk#readme",
	"dependencies": {
		"axios": "^1.21.1",
		"core-js": "^3.51.0",
		"isomorphic-ws": "^4.0.1",
		"jwt-decode": "^3.1.2",
		"pino": "^8.21.0",
		"protobufjs": "7.6.6",
		"ws": "^8.22.2"
	},
	"devDependencies": {
		"@babel/cli": "^7.29.7",
		"@babel/core": "^7.29.13",
		"@babel/preset-env": "^7.29.7",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"babel-loader": "^8.4.1",
		"babel-plugin-transform-import-ignore": "^1.1.0",
		"jsdoc": "^4.0.5",
		"rollup": "^3.30.0",
		"rollup-plugin-inject-process-env": "^1.3.1",
		"webpack": "^5.112.2",
		"webpack-cli": "^4.10.0"
	}
}
